# Copy to .env for local development (never commit .env)

# PostgreSQL connection string — from Vercel Postgres dashboard or local instance
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Flask session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Login credentials for the dashboard
DASHBOARD_USERNAME=will
DASHBOARD_PASSWORD=your-secure-password

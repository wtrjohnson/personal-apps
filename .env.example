# Copy to .env for local development (never commit .env)

# PostgreSQL connection string — from Vercel Postgres dashboard or local instance
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Flask session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Set this wherever DATABASE_URL is set. The built-in development value is published in
# this repository, so anyone could forge a login cookie with it; if the app finds itself
# running on that value against a real database it substitutes a random key and logs a
# warning. That keeps sessions unforgeable, but the key changes on every cold start, so
# you will be logged out repeatedly until a real SECRET_KEY is configured.
SECRET_KEY=change-me-to-a-random-secret

# Login credentials for the dashboard
DASHBOARD_USERNAME=will
DASHBOARD_PASSWORD=your-secure-password

# API key for the Apple Shortcut endpoint — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SHORTCUT_API_KEY=your-random-32-char-hex-key

# Optional. Largest accepted request body, in megabytes. Note intake and business-card
# scanning both post base64 data URLs, so this bounds the biggest canvas or photo that
# can be saved. Defaults to 12.
JOS_MAX_UPLOAD_MB=12

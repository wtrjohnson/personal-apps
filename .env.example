# Copy to .env for local development (never commit .env)

# PostgreSQL connection string — from Vercel Postgres dashboard or local instance
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Flask session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Login credentials for the dashboard
DASHBOARD_USERNAME=will
DASHBOARD_PASSWORD=your-secure-password

# API key for the Apple Shortcut endpoint — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SHORTCUT_API_KEY=your-random-32-char-hex-key

# Secret for the inbound calendar email webhook (Cloudflare Worker sends this as X-Webhook-Secret)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INBOUND_WEBHOOK_SECRET=your-random-32-char-hex-key

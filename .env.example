# Copy to .env for local development (never commit .env)

# PostgreSQL connection string — from Vercel Postgres dashboard or local instance
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Flask session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Login credentials for the dashboard
DASHBOARD_USERNAME=will
DASHBOARD_PASSWORD=your-secure-password

# API key for the Apple Shortcut endpoint — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SHORTCUT_API_KEY=your-random-32-char-hex-key

# Bearer token for the cron/admin endpoints — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
# Without this, POST /api/cron/sync (bill/schedule sync) and POST /api/admin/migrate
# (schema migration) both 503 — the GitHub Actions bill-sync and post-deploy migrate
# workflows stop working silently.
CRON_SECRET=your-random-32-char-hex-key

# Congress.gov API key — request one at https://api.congress.gov/sign-up/
# Without this, the bill tracker sync/detail/schedule endpoints all 503; /api/tracked-bills
# still serves previously-synced data but never updates.
CONGRESS_API_KEY=your-congress-gov-api-key

# Anthropic API key — from https://console.anthropic.com/
# Without this, business-card OCR scanning (POST /api/contacts/scan) silently fails.
ANTHROPIC_API_KEY=your-anthropic-api-key
